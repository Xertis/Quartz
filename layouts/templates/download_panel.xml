<container size="350,40">
    <container size="310, 40" color="#000000bf">
        <label id="download_string" gravity="top-left" margin="5, 5, 0, 0">@Downloading...</label>
        <label id="speed" text-align="right" gravity="top-right" margin="0, 5, 5, 0"></label>
        <container id="progress_bg" size="300, 5" gravity="bottom-left" margin="5, 0, 0, 10" color="#303030ff">
            <container id="progress" size="0, 5" color="#777777ff"></container>
